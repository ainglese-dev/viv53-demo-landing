# Analytics Configuration
# Google Analytics 4 - Get your ID from https://analytics.google.com/
VITE_GA4_ID=G-XXXXXXXXXX

# Google Tag Manager - Get your ID from https://tagmanager.google.com/
VITE_GTM_ID=GTM-XXXXXXX

# Meta Pixel (Facebook) - Get your ID from https://business.facebook.com/events_manager
VITE_META_PIXEL_ID=XXXXXXXXXXXXXX

# Form Submission (currently using formsubmit.co)
# Contact Form: https://formsubmit.co/ajax/info@viv53.com
# Booking Form: https://formsubmit.co/ajax/booking@viv53.com
VITE_CONTACT_FORM_URL=https://docs.google.com/forms/d/e/.../formResponse
VITE_BOOKING_FORM_URL=https://docs.google.com/forms/d/e/.../formResponse

# Contact Configuration
# WhatsApp number for floating button (format: country code + number, no spaces or special characters)
# Example: For +1 (234) 567-8900, use: 12345678900
VITE_WHATSAPP_NUMBER=12345678900

# Contact Information Display
# Email displayed in Contact section and Footer
VITE_CONTACT_EMAIL=info@yourcompany.com
# Phone number for tel: links (format: +[country code][number] - no spaces or dashes)
VITE_CONTACT_PHONE=+12345678900
# Phone number display format (human-readable with formatting)
VITE_CONTACT_PHONE_DISPLAY=+1 (234) 567-8900

# Company Address
VITE_COMPANY_ADDRESS_STREET=8811 NW 78th St
VITE_COMPANY_ADDRESS_CITY=Tamarac
VITE_COMPANY_ADDRESS_STATE=FL
VITE_COMPANY_ADDRESS_ZIP=33321
# Full address for display (will be used if individual fields are not set)
VITE_COMPANY_ADDRESS_FULL=8811 NW 78th St, Tamarac, FL 33321

# Feature Flags
# Enable Spanish language support (set to 'true' when Spanish translations are complete)
VITE_ENABLE_SPANISH=false

# App Configuration
VITE_APP_URL=https://www.viv53.com
VITE_APP_NAME=VIV53 IT Services

# Instructions:
# 1. Copy this file to .env (do not commit .env to git)
# 2. Replace placeholder values with your actual IDs
# 3. Restart your dev server after making changes
# 4. For production, set these in your hosting platform's environment variables
